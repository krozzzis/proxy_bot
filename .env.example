# Telegram bot token from @BotFather
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Telegram user id of the initial (root) administrator.
# This id always has admin panel access, even before admins.toml exists.
ROOT_ADMIN_ID=123456789

# Optional overrides (defaults shown)
# DATA_DIR=./data
# LOGS_DIR=./logs
# LOCALES_DIR=./locales
# DEFAULT_LOCALE=ru
# LOG_LEVEL=INFO

# FSM/dialog state storage: "sqlite" (default, dev-friendly, no extra service)
# or "redis" (prod). REDIS_URL is required when FSM_BACKEND=redis.
# FSM_BACKEND=sqlite
# FSM_SQLITE_PATH=./data/fsm.sqlite3
# FSM_BACKEND=redis
# REDIS_URL=redis://localhost:6379/0

# Remnawave integration (optional). When unset, codes can only carry fixed
# links - the per-user Remnawave account provisioning feature is disabled.
# REMNAWAVE_API_URL=https://panel.example.com
# REMNAWAVE_API_TOKEN=your-remnawave-api-token

# Show traffic used/limit alongside subscription expiry, to users and
# admins alike. Off by default - traffic usage is a coarser, more sensitive
# number than "does this account still have access".
# SHOW_TRAFFIC_USAGE=false

# Watchtower's bundled Docker SDK defaults to an old API version some hosts'
# daemons reject ("client version 1.25 is too old"). Check your host with:
#   docker version --format '{{.Server.APIVersion}}'
# and override here if 1.41 (the default) doesn't work.
# DOCKER_API_VERSION=1.41
