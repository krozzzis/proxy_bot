# Telegram bot token from @BotFather
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Telegram user id of the initial (root) administrator.
# This id always has admin panel access, even before admins.toml exists.
ROOT_ADMIN_ID=123456789

# Optional overrides (defaults shown)
# DATA_DIR=./data
# LOGS_DIR=./logs
# LOCALES_DIR=./locales
# DEFAULT_LOCALE=ru
# LOG_LEVEL=INFO

# FSM/dialog state storage: "sqlite" (default, dev-friendly, no extra service)
# or "redis" (prod). REDIS_URL is required when FSM_BACKEND=redis.
# FSM_BACKEND=sqlite
# FSM_SQLITE_PATH=./data/fsm.sqlite3
# FSM_BACKEND=redis
# REDIS_URL=redis://localhost:6379/0

# Remnawave integration (optional). When unset, codes can only carry fixed
# links - the per-user Remnawave account provisioning feature is disabled.
# REMNAWAVE_API_URL=https://panel.example.com
# REMNAWAVE_API_TOKEN=your-remnawave-api-token

# Show traffic used/limit alongside subscription expiry, to users and
# admins alike. Off by default - traffic usage is a coarser, more sensitive
# number than "does this account still have access".
# SHOW_TRAFFIC_USAGE=false

# Optional branded logo. Unset by default - no logo is sent. Path is
# relative to the working directory the bot runs from (./data is a good
# spot: it's already a gitignored, persistent volume in the Docker setup).
# BRANDED_LOGO_PATH=./data/logo.png
#
# BRANDED_LOGO_MODE controls how it's shown, when BRANDED_LOGO_PATH is set:
#   before  - (default) its own plain photo message right before the main
#             menu, on every /start (mirrors the Liberty VPN bot).
#   caption - attached directly to the main menu message itself (photo with
#             the menu text as its caption, buttons underneath).
# BRANDED_LOGO_MODE=before
#
# Per-locale logo. Optional, on top of an already-optional feature. Without
# any of this, BRANDED_LOGO_PATH is used for every locale. To customize:
#  - drop a `<same name>_<locale><same extension>` file next to
#    BRANDED_LOGO_PATH and it's picked up automatically - logo.png next to
#    logo_ru.png, logo_en.png, ... no config needed.
#  - or point a locale at an arbitrary path explicitly, overriding the
#    auto-detected sibling (if any) for just that locale:
# BRANDED_LOGO_PATH_RU=./data/logo_ru.png
# BRANDED_LOGO_PATH_EN=./data/logo_en.png

# Watchtower's bundled Docker SDK defaults to an old API version some hosts'
# daemons reject ("client version 1.25 is too old"). Check your host with:
#   docker version --format '{{.Server.APIVersion}}'
# and override here if 1.41 (the default) doesn't work.
# DOCKER_API_VERSION=1.41
